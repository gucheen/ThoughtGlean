# 可选备用登录：openssl rand -hex 32；留空时仅使用 OIDC。
THOUGHTGLEAN_OWNER_TOKEN=
THOUGHTGLEAN_VERSION=0.1.0

# 使用 ./data 可直接在宿主机查看和备份服务端数据；留空则使用 Docker 命名卷。
THOUGHTGLEAN_DATA_PATH=./data

# 自动备份建议挂载到与主数据不同的目录或磁盘。
THOUGHTGLEAN_BACKUP_PATH=./backups
THOUGHTGLEAN_BACKUP_INTERVAL=24h
THOUGHTGLEAN_BACKUP_KEEP=14

# 默认仅监听宿主机回环地址，适合由 Caddy/Nginx/Cloudflare Tunnel 提供 HTTPS。
THOUGHTGLEAN_HTTP_BIND=127.0.0.1
THOUGHTGLEAN_HTTP_PORT=8080

# 在身份服务中创建 confidential client，启用授权码流程和 PKCE S256。
# 以下五项必须同时填写；不使用 OIDC 时，必须配置上面的个人访问密钥。
THOUGHTGLEAN_OIDC_ISSUER=
THOUGHTGLEAN_OIDC_CLIENT_ID=
THOUGHTGLEAN_OIDC_CLIENT_SECRET=
THOUGHTGLEAN_OIDC_REDIRECT_URL=
# 唯一允许访问笔记的账号在此客户端 ID Token 中的 sub，不是邮箱或用户名。
THOUGHTGLEAN_OIDC_OWNER_SUBJECT=
