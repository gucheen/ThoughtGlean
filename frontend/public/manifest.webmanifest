{
  "name": "拾念 ThoughtGlean",
  "short_name": "拾念",
  "display": "standalone",
  "start_url": "/",
  "background_color": "#f7f8fa",
  "theme_color": "#f7f8fa",
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [{ "name": "images", "accept": ["image/*"] }]
    }
  }
}
